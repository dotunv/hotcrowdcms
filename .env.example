# HotCrowd CMS Environment Variables

# LOCAL DEVELOPMENT ONLY. The app defaults to DEBUG=false when this is unset; production must leave it off.
# DEBUG=true enables dev shortcuts that are unsafe on a public server: the reset link is returned in the
# /auth/forgot response (only when no EMAIL_HOST is set), checkout upgrades the account without payment
# (only when Stripe is not configured), tables are auto-created and the insecure dev SECRET_KEY is accepted.
DEBUG=true

# Postgres (Neon) — used only by apps/api
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Required and must not be a placeholder when DEBUG=False
SECRET_KEY=change-me

# Public origin the player uses for media URLs (must not be localhost in production)
PUBLIC_API_URL=http://127.0.0.1:8000

# Player CORS only. CMS talks same-origin through Next rewrites.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,https://hotcrowd-web-player.vercel.app

# Leave unset to derive from DEBUG (secure cookies when DEBUG=False)
# COOKIE_SECURE=true
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# CMS origin used in password-reset emails
PUBLIC_WEB_URL=http://127.0.0.1:3000

# Optional SMTP. If empty, reset links print to the API console (DEBUG).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM=noreply@hotcrowd.local

# Stripe (optional). Without keys, DEBUG checkout upgrades the account locally.
# STRIPE_WEBHOOK_SECRET is REQUIRED to accept webhooks at all (unsigned events are refused with 503), and
# production refuses to start if STRIPE_SECRET_KEY is set without it. Locally: `stripe listen` prints one.
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=

# Rate limiting needs the real client address. How many reverse proxies sit in front of the API (load
# balancer, the Next.js /api rewrite, ...)? The client is the Nth X-Forwarded-For entry from the right.
# Too low: every user shares the proxy's bucket and gets throttled together. Too high (or a proxy count of
# 1 while the API is exposed directly): clients can spoof their address and dodge limits. 0 = trust no header.
TRUSTED_PROXY_COUNT=1

# PBKDF2 cost for password hashing. Leave unset (1,000,000); production refuses anything under 600,000.
# PASSWORD_HASH_ITERATIONS=1000000

# Server-side URL fetches (Instagram import) refuse private/loopback/link-local addresses. Set true ONLY on a
# dev machine to import from a local server; production refuses to start with it enabled.
ALLOW_PRIVATE_FETCH=false

# Shared rate-limit store. Leave empty to count per process (fine for one instance); set it when you run
# several API instances so login/pairing limits are enforced across all of them, e.g. redis://redis:6379/0.
# If Redis is down the API keeps limiting with in-process counts.
REDIS_URL=

# Instagram Graph (optional). URL import works without this.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Cloudflare R2 (production file storage). Local disk when False.
USE_S3=False
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_CUSTOM_DOMAIN=

# Container: run `alembic upgrade head` before starting (default 1). Set 0 on all but one replica.
# RUN_MIGRATIONS=1
